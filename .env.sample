# Primary RPC endpoints:
# Enjin Relay: wss://rpc.relay.blockchain.enjin.io
# Enjin Matrix: wss://rpc.matrix.blockchain.enjin.io
# Canary Relay: wss://rpc.relay.canary.enjin.io
# Canary Matrix: wss://rpc.matrix.canary.enjin.io
# Default: Enjin Relaychain.
SAS_SUBSTRATE_URL=wss://rpc.relay.blockchain.enjin.io
SAS_SUBSTRATE_MULTI_CHAIN_URL=[]
SAS_EXPRESS_BIND_HOST=127.0.0.1
SAS_EXPRESS_PORT=8080
SAS_LOG_LEVEL=info

# For Matrixchain, set SAS_SUBSTRATE_URL to its RPC endpoint and optionally
# configure the matching relay. matrix-enjin requires enjin; matrix requires canary.
# SAS_SUBSTRATE_MULTI_CHAIN_URL='[{"url":"wss://rpc.relay.blockchain.enjin.io","type":"relay"}]'
# Canary Matrixchain relay configuration:
# SAS_SUBSTRATE_MULTI_CHAIN_URL='[{"url":"wss://rpc.relay.canary.enjin.io","type":"relay"}]'
