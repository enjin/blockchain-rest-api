    "babel-loader": "^9.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.0",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
